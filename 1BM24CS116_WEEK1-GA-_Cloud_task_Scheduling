        "import random\n",
        "\n",
        "NUM_TASKS = 20\n",
        "NUM_VMS = 5\n",
        "\n",
        "tasks = [{'id': i, 'length': random.randint(100, 1000)} for i in range(NUM_TASKS)]\n",
        "\n",
        "vms = [\n",
        "    {\n",
        "        'id': i,\n",
        "        'mips': random.randint(500, 2000),\n",
        "        'energy_per_mi': random.uniform(0.1, 0.4),\n",
        "        'cost_per_sec': random.uniform(0.05, 0.15),\n",
        "    }\n",
        "    for i in range(NUM_VMS)\n",
        "]\n",
        "\n",
        "POP_SIZE = 50\n",
        "GENERATIONS = 150\n",
        "MUTATION_RATE = 0.15\n",
        "CROSSOVER_RATE = 0.80\n",
        "\n",
        "\n",
        "def calculate_fitness(chromosome):\n",
        "    vm_execution_times = [0.0] * NUM_VMS\n",
        "    vm_energy_spent = [0.0] * NUM_VMS\n",
        "\n",
        "    for task_id, vm_id in enumerate(chromosome):\n",
        "        task = tasks[task_id]\n",
        "        vm = vms[vm_id]\n",
        "\n",
        "        exec_time = task['length'] / vm['mips']\n",
        "        vm_execution_times[vm_id] += exec_time\n",
        "        vm_energy_spent[vm_id] += task['length'] * vm['energy_per_mi']\n",
        "\n",
        "    makespan = max(vm_execution_times)\n",
        "    total_energy = sum(vm_energy_spent)\n",
        "    total_cost = sum(\n",
        "        vm_execution_times[i] * vms[i]['cost_per_sec'] for i in range(NUM_VMS)\n",
        "    )\n",
        "\n",
        "    w_time, w_energy, w_cost = 0.4, 0.3, 0.3\n",
        "    total_penalty = (\n",
        "        (w_time * makespan) + (w_energy * total_energy) + (w_cost * total_cost)\n",
        "    )\n",
        "\n",
        "    return 1.0 / (total_penalty + 1e-6)\n",
        "\n",
        "\n",
        "def create_individual():\n",
        "    return [random.randint(0, NUM_VMS - 1) for _ in range(NUM_TASKS)]\n",
        "\n",
        "\n",
        "def min_min_heuristic():\n",
        "    chromosome = [-1] * NUM_TASKS\n",
        "    ready_times = [0.0] * NUM_VMS\n",
        "    unmapped_tasks = list(range(NUM_TASKS))\n",
        "\n",
        "    while unmapped_tasks:\n",
        "        min_completion_time = float('inf')\n",
        "        best_task = -1\n",
        "        best_vm = -1\n",
        "\n",
        "        for task_id in unmapped_tasks:\n",
        "            for vm_id in range(NUM_VMS):\n",
        "                exec_time = tasks[task_id]['length'] / vms[vm_id]['mips']\n",
        "                completion_time = ready_times[vm_id] + exec_time\n",
        "                if completion_time < min_completion_time:\n",
        "                    min_completion_time = completion_time\n",
        "                    best_task = task_id\n",
        "                    best_vm = vm_id\n",
        "\n",
        "        chromosome[best_task] = best_vm\n",
        "        exec_time = tasks[best_task]['length'] / vms[best_vm]['mips']\n",
        "        ready_times[best_vm] += exec_time\n",
        "        unmapped_tasks.remove(best_task)\n",
        "\n",
        "    return chromosome\n",
        "\n",
        "\n",
        "def max_min_heuristic():\n",
        "    chromosome = [-1] * NUM_TASKS\n",
        "    ready_times = [0.0] * NUM_VMS\n",
        "    unmapped_tasks = list(range(NUM_TASKS))\n",
        "\n",
        "    while unmapped_tasks:\n",
        "        chosen_task = -1\n",
        "        chosen_vm = -1\n",
        "        max_completion_time = -1.0\n",
        "\n",
        "        for task_id in unmapped_tasks:\n",
        "            min_vm_completion = float('inf')\n",
        "            best_vm_for_task = -1\n",
        "\n",
        "            for vm_id in range(NUM_VMS):\n",
        "                exec_time = tasks[task_id]['length'] / vms[vm_id]['mips']\n",
        "                completion_time = ready_times[vm_id] + exec_time\n",
        "                if completion_time < min_vm_completion:\n",
        "                    min_vm_completion = completion_time\n",
        "                    best_vm_for_task = vm_id\n",
        "\n",
        "            if min_vm_completion > max_completion_time:\n",
        "                max_completion_time = min_vm_completion\n",
        "                chosen_task = task_id\n",
        "                chosen_vm = best_vm_for_task\n",
        "\n",
        "        chromosome[chosen_task] = chosen_vm\n",
        "        exec_time = tasks[chosen_task]['length'] / vms[chosen_vm]['mips']\n",
        "        ready_times[chosen_vm] += exec_time\n",
        "        unmapped_tasks.remove(chosen_task)\n",
        "\n",
        "    return chromosome\n",
        "\n",
        "\n",
        "def crossover(parent1, parent2):\n",
        "    if random.random() < CROSSOVER_RATE:\n",
        "        point = random.randint(1, NUM_TASKS - 1)\n",
        "        child1 = parent1[:point] + parent2[point:]\n",
        "        child2 = parent2[:point] + parent1[point:]\n",
        "        return child1, child2\n",
        "    return parent1.copy(), parent2.copy()\n",
        "\n",
        "\n",
        "def mutate(individual):\n",
        "    for i in range(NUM_TASKS):\n",
        "        if random.random() < MUTATION_RATE:\n",
        "            individual[i] = random.randint(0, NUM_VMS - 1)\n",
        "    return individual\n",
        "\n",
        "\n",
        "def print_detailed_schedule(chromosome):\n",
        "    print(\"\\n================ DETAILED SCHEDULE TIMELINE ================\")\n",
        "\n",
        "    schedule_map = {i: [] for i in range(NUM_VMS)}\n",
        "\n",
        "    for task_id, vm_id in enumerate(chromosome):\n",
        "        schedule_map[vm_id].append(tasks[task_id])\n",
        "\n",
        "    for vm_id in range(NUM_VMS):\n",
        "        assigned_tasks = schedule_map[vm_id]\n",
        "        vm_profile = vms[vm_id]\n",
        "\n",
        "        print(\n",
        "            f\"\\n[VM {vm_id}] Capacity: {vm_profile['mips']} MIPS | Energy/MI: {vm_profile['energy_per_mi']:.2f} | Cost/Sec: {vm_profile['cost_per_sec']:.2f}\"\n",
        "        )\n",
        "\n",
        "        if not assigned_tasks:\n",
        "            print(\"  -> No tasks scheduled on this machine (Idle).\")\n",
        "            continue\n",
        "\n",
        "        accumulated_time = 0.0\n",
        "        total_vm_energy = 0.0\n",
        "\n",
        "        print(\"  Assigned Tasks Execution Queue:\")\n",
        "        for t in assigned_tasks:\n",
        "            duration = t['length'] / vm_profile['mips']\n",
        "            energy = t['length'] * vm_profile['energy_per_mi']\n",
        "            cost = duration * vm_profile['cost_per_sec']\n",
        "\n",
        "            start_time = accumulated_time\n",
        "            accumulated_time += duration\n",
        "            total_vm_energy += energy\n",
        "\n",
        "            print(\n",
        "                f\"    - Task ID {t['id']:02d} (Len: {t['length']:4d} MI) -> Timeline: [{start_time:.3f}s to {accumulated_time:.3f}s] | Energy: {energy:.1f} | Cost: ${cost:.3f}\"\n",
        "            )\n",
        "\n",
        "        print(\n",
        "            f\"  Subtotal metrics -> Active Runtime: {accumulated_time:.3f}s | Combined Energy: {total_vm_energy:.1f} units | Total Expense: ${accumulated_time * vm_profile['cost_per_sec']:.3f}\"\n",
        "        )\n",
        "\n",
        "\n",
        "population = [min_min_heuristic(), max_min_heuristic()]\n",
        "while len(population) < POP_SIZE:\n",
        "    population.append(create_individual())\n",
        "\n",
        "print('Starting genetic optimization evolution with hybrid seedings...')\n",
        "\n",
        "for gen in range(GENERATIONS):\n",
        "    fitness_scores = [calculate_fitness(ind) for ind in population]\n",
        "    total_fitness = sum(fitness_scores)\n",
        "    selection_probabilities = [f / total_fitness for f in fitness_scores]\n",
        "\n",
        "    next_generation = []\n",
        "    best_idx = fitness_scores.index(max(fitness_scores))\n",
        "    next_generation.append(population[best_idx].copy())\n",
        "\n",
        "    while len(next_generation) < POP_SIZE:\n",
        "        parent1 = random.choices(population, weights=selection_probabilities, k=1)[0]\n",
        "        parent2 = random.choices(population, weights=selection_probabilities, k=1)[0]\n",
        "\n",
        "        child1, child2 = crossover(parent1, parent2)\n",
        "        next_generation.append(mutate(child1))\n",
        "        if len(next_generation) < POP_SIZE:\n",
        "            next_generation.append(mutate(child2))\n",
        "\n",
        "    population = next_generation\n",
        "\n",
        "final_fitness = [calculate_fitness(ind) for ind in population]\n",
        "best_final_idx = final_fitness.index(max(final_fitness))\n",
        "best_schedule = population[best_final_idx]\n",
        "\n",
        "print('\\n--- OPTIMIZATION COMPLETE ---')\n",
        "print(f'Optimal Task Assignment Strategy Matrix:\\n{best_schedule}')\n",
        "print(f'Maximized Fitness Score achieved: {max(final_fitness):.6f}')\n",
        "\n",
        "print_detailed_schedule(best_schedule)\n"
      ]
